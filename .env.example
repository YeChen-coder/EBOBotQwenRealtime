# 通义千问 API 配置
QWEN_API_KEY=sk-your-api-key-here
# QWEN_WORKSPACE_ID 已不需要（使用标准 dashscope.aliyuncs.com 地址）
QWEN_REGION=cn
QWEN_MODEL=qwen3.8-omni-flash-realtime

# EBO 机器人配置
EBO_API_URL=http://ebo-engine:8098
EBO_API_TOKEN=your_ebo_api_token
EBO_NODE=ebo
EBO_TALK_STREAM_URL=ws://ebo-engine:8200/talk
EBO_AUDIO_STREAM_URL=
EBO_RTSP_URL=rtsp://ebo-engine:8554/ebo

# 音频配置
EBO_STREAM_PREBUFFER_MS=200
EBO_STREAM_CONNECT_TIMEOUT_SECONDS=10
EBO_PLAYBACK_TAIL_MS=800

# 服务配置
EBO_ASSISTANT_PORT=8099
EBO_ASSISTANT_AUDIO_URL=http://realtime-assistant:8099/audio

# 数据存储路径
EBO_TRANSCRIPT_PATH=/data/transcripts.jsonl
EBO_OUTPUT_AUDIO_DIR=/data/replies
EBO_ASSISTANT_TRANSCRIPT_PATH=/data/assistant_outputs.jsonl
# 全家一份的记忆（memory.py）：每场对话后写笔记，攒够几条 / 每晚 3 点整理一次，新对话开头带上
# 文件都在这个目录：memory.json（记忆）、notes.json（待整理的笔记）、seed.json（家人自己写的固定事实，隐私）
EBO_MEMORY_DIR=/data/memory
EBO_MEMORY_ENABLED=true
EBO_MEMORY_NOTE_MODEL=qwen-plus
# 整理用的模型，按顺序试，账号里没有的自动跳过
EBO_MEMORY_MODEL=qwen3-max,qwen-max
EBO_MEMORY_CONSOLIDATE_AFTER=4
# 放进每场对话 instructions 的上限（字）；每轮回复都会重复计费，别太长
EBO_MEMORY_CONTEXT_CHARS=2500

# 助手配置
EBO_ASSISTANT_INSTRUCTIONS=你是家里的 EBO 机器人助手。用自然、简洁、温暖的中文交谈。没有把握就明确说不知道。
EBO_VOICE=longanlingxin
EBO_AUTO_WAKE=true

# Frigate 配置
EBO_FRIGATE_URL=http://frigate:5000
EBO_CAMERA_NAME=ebo
EBO_MQTT_HOST=mosquitto
EBO_MQTT_PORT=1883

# 会话配置
EBO_SESSION_IDLE_SECONDS=300
EBO_SESSION_MAX_SECONDS=2700
EBO_COOLDOWN_SECONDS=90

# Standby 唤醒（本地 Whisper）
EBO_VOICE_WAKE_ENABLED=true
# tiny / base / small：越大越准越慢（本机实测每句 base 约 0.75 秒、small 约 2.6 秒）
EBO_WHISPER_MODEL=small
EBO_WHISPER_LANGUAGE=zh
# 逗号分隔的唤醒词：说了马上唤醒，不经过判断
EBO_WAKE_WORDS=猫猫,小朋友,小机器人,狗狗,狗儿
# 不说唤醒词也能自然接话：其他话由小模型判断是不是在对机器人说（挡掉电视对白、家人之间说话）
EBO_ADDRESSEE_CHECK=true
EBO_ADDRESSEE_MODEL=qwen-plus

# 日志目录（滚动文件 assistant.log）；看板在 http://<本机>:8099/
EBO_LOG_DIR=logs
# 唤醒句结束判定的静音时长（毫秒）
EBO_STANDBY_SILENCE_MS=900

# 联网搜索（通义千问内置 enable_search，模型自行判断何时搜索，无需额外 API Key）
EBO_WEB_SEARCH_ENABLED=true

# 视觉跟随：看到人就转向并靠近（不会倒车；暂停助手或用户说话时不动）
EBO_TRACKING_ENABLED=false
# 跟随把机器人带离充电座后，连续这么久（秒）没看到人就自动回充（走远了会先原地转一圈找人）
EBO_TRACKING_DOCK_AFTER_SECONDS=300
# 找人转圈（30° x 24 次 = 两圈）时，每停一个方向自己用 YOLOv9 识别一次；门槛比 Frigate 低，能认出沙发上半身/趴着的人
EBO_TRACKING_SCAN_ENABLED=true
EBO_SCAN_MIN_SCORE=0.5
# 用户说“回去充电”后：机器人回充电座，这么久（秒）内不追人
EBO_DOCK_REST_SECONDS=1080
# 用户说“闭嘴”“别说了”“不需要你”后：这么久（秒）只认唤醒词，其他话照常听写但不接
EBO_QUIET_SECONDS=900

# VAD 配置（会话中本地判断一轮说完的静音时长也用 EBO_VAD_SILENCE_DURATION_MS）
REALTIME_VAD_THRESHOLD=0.65
EBO_VAD_PREFIX_PADDING_MS=300
EBO_VAD_SILENCE_DURATION_MS=650

# 视觉配置
EBO_VISUAL_ENABLED=true
REALTIME_IMAGE_WIDTH=768
REALTIME_IMAGE_QUALITY=75

# 用户配置（JSON 格式）
EBO_USERS_JSON=[{"id":"mother","face_name":"妈妈","display_name":"妈妈"},{"id":"father","face_name":"爸爸","display_name":"爸爸"}]

# 家人回家主动打招呼：Frigate 认出这些人脸、且已 3 小时没见到、在 11~23 点之间，每人每天最多一次
EBO_PROACTIVE_GREETING_ENABLED=true
EBO_GREET_NAMES=妈妈
EBO_GREET_AWAY_SECONDS=10800
EBO_GREET_HOURS=11-23
# 上面的时段按家里的时间算；程序和机器人不在同一个时区时要写，例如 Asia/Shanghai（空 = 这台电脑的时间）
EBO_HOME_TIMEZONE=

# 每天早上定时播报天气（提前 15 分钟取天气、录好音，到点直接播；时间按 EBO_HOME_TIMEZONE 算）
EBO_WEATHER_ENABLED=false
EBO_WEATHER_TIME=06:00
EBO_WEATHER_CITY=天津
EBO_WEATHER_LAT=39.1422
EBO_WEATHER_LON=117.1767
EBO_WEATHER_NAME=妈妈
# 迎接时额外的提醒（一行写完）。家人的工作等事实请写进 data/memory/seed.json 的固定事实，已不用写在这里
EBO_GREET_CONTEXT=
